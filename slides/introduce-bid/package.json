{
  "name": "introduce-bid",
  "description": "DenoでIMEユーザー辞書を統一的に出力するツールを作った",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build --base /introduce-bid --router-mode hash --out ../../dist/introduce-bid",
    "export": "slidev export",
    "ogp": "slidev export --format png --range 1 --per-slide --output .ogp-tmp"
  }
}
