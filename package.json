{
  "name": "slides",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "volta": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@11.28.7+sha512.2161a30a2dc64b0c0f09786496fbce5f061be96b8ff11f0bc98e6bc675e0074ceb225b9197a278f2f171e6c9fb971bd1df8932e5bc31053baccdd52b15a1ae26",
  "scripts": {
    "create-slide": "deno run --allow-run=pnpm,deno --allow-write --allow-read --allow-env --no-lock scripts/create.ts",
    "dev": "deno run --allow-run=pnpm --allow-read --allow-env --no-lock scripts/dev.ts",
    "ogp": "deno run --allow-run=pnpm --allow-read --allow-write --allow-env --no-lock scripts/ogp.ts",
    "build": "rimraf dist && pnpm -r --workspace-concurrency=1 build && tsx index.tsx",
    "preview": "wrangler dev",
    "export": "pnpm -r export",
    "fmt": "deno fmt --ignore=README.md,*/**/*.md"
  },
  "dependencies": {
    "@slidev/cli": "^52.18.0",
    "@slidev/theme-default": "latest",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.5.5",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "playwright-chromium": "^1.62.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "wrangler": "^4.117.0"
  }
}
