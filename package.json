{
  "name": "slides",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "volta": {
    "node": "24.22.2"
  },
  "packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3",
  "scripts": {
    "create-slide": "deno run --allow-run=pnpm,deno --allow-write --allow-read --allow-env --no-lock scripts/create.ts",
